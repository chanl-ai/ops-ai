 {
  "name": "place_hold",
  "server": "Harbor & Pine Core Banking",
  "description": "Place a hold on funds in an account. Moves money: a reviewer approves every call.",
  "access": "write",
  "requires_approval": true,
  "approvers": 1,
  "input_schema": {
   "type": "object",
   "properties": {
    "accountId": {
     "type": "string"
    },
    "amount": {
     "type": "number",
     "minimum": 0.01
    },
    "reason": {
     "type": "string"
    }
   },
   "required": [
    "accountId",
    "amount",
    "reason"
   ]
  },
  "kind": "draft",
  "approval": {
   "title": "Hold {amount} on account {accountId}",
   "action": "Hold {amount} on {accountId}",
   "summary": "{reason}",
   "consequence": "Approving holds these funds; the customer cannot withdraw them until the hold is released.",
   "fields": [
    [
     "Account",
     "{accountId}"
    ],
    [
     "Amount",
     "{amount}"
    ],
    [
     "Reason",
     "{reason}"
    ]
   ],
   "gate": "Levy review",
   "reviewers": "Operations",
   "result": "Hold {reference} placed on {accountId} for {amount}.",
   "risk": "high"
  },
  "step_up": true
 },
 {
  "name": "add_customer_note",
  "server": "Harbor & Pine Core Banking",
  "description": "Write a note on a customer's record.",
  "access": "write",
  "requires_approval": true,
  "approvers": 1,
  "input_schema": {
   "type": "object",
   "properties": {
    "customerId": {
     "type": "string"
    },
    "text": {
     "type": "string"
    }
   },
   "required": [
    "customerId",
    "text"
   ]
  },
  "kind": "draft",
  "approval": {
   "title": "Note on customer {customerId}",
   "action": "Write a note on {customerId}",
   "summary": "{text}",
   "consequence": "Approving writes this note on the customer's record, where every teammate reads it.",
   "fields": [
    [
     "Customer",
     "{customerId}"
    ],
    [
     "Note",
     "{text}"
    ]
   ],
   "gate": "Levy review",
   "reviewers": "Operations",
   "result": "Note {reference} written on {customerId}.",
   "risk": "medium"
  }
 }
]
