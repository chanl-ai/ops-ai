  "task-types.create": {
    "body": {
      "data": {
        "copiedFrom": {
          "id": "write_approval",
          "version": 1
        },
        "description": "Approve a change before it is made in another system.",
        "id": "vendor_bank_change",
        "name": "Copied",
        "origin": "team",
        "publishedVersion": null,
        "teamId": "team_ops",
        "updatedAt": "<timeZ>",
        "updatedBy": "james@harborpine.example",
        "version": 1,
        "versions": [
          {
            "publishedAt": null,
            "record": {
              "actions": [
                {
                  "consequence": "{onApprove}",
                  "label": "Make the change",
                  "name": "approve",
                  "port": "approve",
                  "reason": "optional",
                  "tone": "primary"
                },
                {
                  "consequence": "{onReject}",
                  "label": "Decline",
                  "name": "reject",
                  "port": "reject",
                  "reason": "required",
                  "tone": "destructive"
                }
              ],
              "description": "Approve a change before it is made in another system.",
              "name": "Copied",
              "params": {
                "properties": {
                  "call": {
                    "type": "object"
                  },
                  "facts": {
                    "type": "array"
                  },
                  "history": {
                    "type": "array"
                  },
                  "onApprove": {
                    "fallback": "The change is made now.",
                    "type": "string"
                  },
                  "onReject": {
                    "fallback": "Nothing changes.",
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "title": {
                    "fallback": "Approve this change",
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "call"
                ],
                "type": "object"
              },
              "regions": [
                {
                  "bind": {
                    "title": "{title}"
                  },
                  "region": "header"
                },
                {
                  "bind": {
                    "source": "{source}",
                    "why": "{why}"
                  },
                  "region": "why_source"
                },
                {
                  "bind": {
                    "facts": "{facts}"
                  },
                  "region": "facts"
                },
                {
                  "bind": {
                    "call": "{call}"
                  },
                  "region": "write_preview"
                },
                {
                  "bind": {
                    "events": "{history}"
                  },
                  "collapsed": true,
                  "region": "history"
                }
              ]
            },
            "savedAt": "<timeZ>",
            "savedBy": "james@harborpine.example",
            "version": 1
          }
        ]
      },
      "success": true
    },
    "status": 201
  },
