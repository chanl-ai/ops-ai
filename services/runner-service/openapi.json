{
  "components": {
    "schemas": {
      "Envelope_RunOut_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RunOut"
          },
          "success": {
            "const": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "title": "Envelope[RunOut]",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "title": "Details"
          },
          "kind": {
            "enum": [
              "input",
              "refused",
              "upstream",
              "timeout",
              "internal"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "status",
          "requestId",
          "kind",
          "retryable"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "success": {
            "const": false,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ErrorOut": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "capacity": {
            "title": "Capacity",
            "type": "integer"
          },
          "running": {
            "title": "Running",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "running",
          "capacity"
        ],
        "title": "Health",
        "type": "object"
      },
      "JsonValue": {},
      "LimitsIn": {
        "additionalProperties": false,
        "properties": {
          "calls": {
            "default": 20,
            "minimum": 0.0,
            "title": "Calls",
            "type": "integer"
          },
          "memoryMb": {
            "default": 256,
            "minimum": 32.0,
            "title": "Memorymb",
            "type": "integer"
          },
          "timeS": {
            "default": 10.0,
            "exclusiveMinimum": 0.0,
            "title": "Times",
            "type": "number"
          }
        },
        "title": "LimitsIn",
        "type": "object"
      },
      "RunIn": {
        "additionalProperties": false,
        "properties": {
          "callToken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calltoken"
          },
          "entry": {
            "default": "main",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Entry",
            "type": "string"
          },
          "input": {
            "title": "Input"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsIn"
          },
          "source": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "RunIn",
        "type": "object"
      },
      "RunOut": {
        "additionalProperties": false,
        "properties": {
          "calls": {
            "title": "Calls",
            "type": "integer"
          },
          "createMs": {
            "title": "Createms",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "executeMs": {
            "title": "Executems",
            "type": "integer"
          },
          "log": {
            "title": "Log",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "output": {
            "$ref": "#/components/schemas/JsonValue"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceOut"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "log",
          "calls",
          "createMs",
          "executeMs",
          "trace"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "TraceOut": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "ok"
        ],
        "title": "TraceOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Ops AI runner service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ],
        "x-ops-public": "sdk"
      }
    },
    "/v1/runs": {
      "post": {
        "description": "Runs `entry(input)` from `source` in a fresh sandbox and answers when it ends: its output or the error that\nstopped it (`time_limit`, `memory_limit`, `function_error`, or a refused call's code), its log and timings.",
        "operationId": "runs_run",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_RunOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not signed in"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not allowed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflicts with the current state"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Refused by a rule"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Over a budget or rate limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Server error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service unavailable"
          }
        },
        "summary": "Run",
        "tags": [
          "runs"
        ],
        "x-ops-public": "internal"
      }
    }
  }
}
