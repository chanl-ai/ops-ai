{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "git -C \"$(git rev-parse --show-toplevel)\" diff --quiet HEAD^ HEAD -- docs services apps/docs pnpm-lock.yaml",
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [{ "source": "/", "destination": "/docs", "permanent": false }],
  "rewrites": [
    { "source": "/docs", "destination": "/index" },
    { "source": "/docs/", "destination": "/index" },
    { "source": "/docs/:path*", "destination": "/:path*" }
  ]
}
