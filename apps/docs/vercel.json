{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [{ "source": "/", "destination": "/docs", "permanent": false }],
  "rewrites": [
    { "source": "/docs", "destination": "/index" },
    { "source": "/docs/", "destination": "/index" },
    { "source": "/docs/:path*", "destination": "/:path*" }
  ]
}
