{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|docs/*) git -C \"$(git rev-parse --show-toplevel)\" diff --quiet HEAD^ HEAD -- docs services apps/docs pnpm-lock.yaml ;; *) exit 0 ;; esac",
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/docs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/index"
    },
    {
      "source": "/docs/",
      "destination": "/index"
    },
    {
      "source": "/docs/:path*",
      "destination": "/:path*"
    }
  ]
}
