{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "description": "The Ops AI docs site: renders ../../docs and services/*/openapi.json at build time",
  "scripts": {
    "dev": "NEXT_PUBLIC_UI_FEEDBACK=${NEXT_PUBLIC_UI_FEEDBACK:-$(curl -sf -m 1 http://127.0.0.1:4790/health >/dev/null && echo 1 || echo 0)} next dev -p 3040",
    "build": "node scripts/check-links.mjs && node scripts/check-public-pages.mjs && node scripts/check-icons.mjs && node scripts/export-diagrams.mjs --check && next build",
    "start": "next start -p 3040",
    "check:links": "node scripts/check-links.mjs && node scripts/check-public-pages.mjs && node scripts/check-icons.mjs",
    "diagrams": "node scripts/export-diagrams.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-openapi": "^12.5.5",
    "fumadocs-ui": "^16.17.8",
    "github-slugger": "^2.0.0",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
