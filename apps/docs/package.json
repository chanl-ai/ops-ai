{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "description": "The Ops AI docs site: renders ../../docs and services/*/openapi.json at build time",
  "scripts": {
    "dev": "NEXT_PUBLIC_UI_FEEDBACK=${NEXT_PUBLIC_UI_FEEDBACK:-$(curl -sf -m 1 http://127.0.0.1:4790/health >/dev/null && echo 1 || echo 0)} next dev -p 3040",
    "build": "node scripts/check-links.mjs && node scripts/export-diagrams.mjs --check && next build",
    "start": "next start -p 3040",
    "check:links": "node scripts/check-links.mjs",
    "diagrams": "node scripts/export-diagrams.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.15.15",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-openapi": "^12.0.4",
    "fumadocs-ui": "^16.15.15",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.474.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
