            {
              "date": "2026-10-14",
              "description": "Payroll",
              "amount": 3150
            }
          ],
          "columns": [
            {
              "key": "date",
              "label": "Date",
              "format": "date"
            },
            {
              "key": "description",
              "label": "Description"
            },
            {
              "key": "amount",
              "label": "Amount",
              "format": "money"
            }
          ]
        },
        {
          "type": "row",
          "gap": "sm",
          "children": [
            {
              "type": "button",
              "label": "Show wire history",
              "reply": {
                "text": "Show the recent wire history for this account.",
                "values": {
                  "account": "CHQ-2219"
                }
              },
              "requires": "get_wire_history"
            },
            {
              "type": "button",
              "label": "Keep it held",
              "reply": {
                "text": "Keep this hold in place.",
                "values": {
                  "holdId": "hold_204"
                }
              }
            }
          ]
        }
      ]
    }
