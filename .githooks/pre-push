#!/bin/sh
# ops-ai push check: lint and format on the Python files the pushed commits change, in seconds. The tests run in CI on
# the pull request (only the areas it touches) and in full on main every night; a full local run before every push took
# about 20 minutes and failed for reasons unrelated to the change. codeloop's own pre-push hook, when installed by
# scripts/install-hooks.sh as pre-push.codeloop, runs first on the same refs.
cd "$(git rev-parse --show-toplevel)" || exit 1
refs=$(cat)
d=$(git rev-parse --git-common-dir) || exit 1
if [ -x "$d/hooks/pre-push.codeloop" ]; then printf '%s\n' "$refs" | "$d/hooks/pre-push.codeloop" "$@" || exit $?; fi
zero=0000000000000000000000000000000000000000
printf '%s\n' "$refs" | while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue  # a delete sends no commits
  since=$remote_sha
  if [ "$since" = "$zero" ] || ! git cat-file -e "$since^{commit}" 2>/dev/null; then
    since=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  fi
  [ -n "$since" ] || continue
  files=$(git diff --name-only --diff-filter=ACMR "$since" "$local_sha" -- '*.py' | while read -r f; do [ -f "$f" ] && echo "$f"; done)
  [ -n "$files" ] || continue
  # shellcheck disable=SC2086
  uv run --quiet ruff check $files && uv run --quiet ruff format --check $files \
    || { echo "pre-push: lint or format failed on the files above; run uv run ruff format <file> and uv run ruff check --fix <file>"; exit 1; }
done
