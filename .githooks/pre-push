#!/bin/sh
# ops-ai hook: lint and format of the Python files the pushed commits change; the tests run in CI.
cd "$(git rev-parse --show-toplevel)" || exit 1
root=$PWD
# OPS_RUFF names another ruff (scripts/tests/test_pre_push.py); by default the workspace's.
ruff=${OPS_RUFF:-"uv run --quiet --project $root ruff"}
refs=$(cat)
d=$(git rev-parse --git-common-dir) || exit 1
if [ -x "$d/hooks/pre-push.local" ]; then printf '%s\n' "$refs" | "$d/hooks/pre-push.local" "$@" || exit $?; fi
zero=0000000000000000000000000000000000000000
printf '%s\n' "$refs" | while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue  # a delete sends no commits
  since=$remote_sha
  if [ "$since" = "$zero" ] || ! git cat-file -e "$since^{commit}" 2>/dev/null; then
    since=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  fi
  [ -n "$since" ] || continue
  files=$(git diff --name-only --diff-filter=ACMR "$since" "$local_sha" -- '*.py')
  [ -n "$files" ] || continue
  # The pushed content, not the working tree: another builder's unfinished file must not block this push. The files are
  # exported from the pushed commit with the lint configuration, and ruff runs there.
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/ops-pre-push.XXXXXX")
  # shellcheck disable=SC2046,SC2086
  git archive "$local_sha" pyproject.toml $(git ls-tree --name-only "$local_sha" ruff.toml .ruff.toml 2>/dev/null) $files | tar -x -C "$tmp"
  # shellcheck disable=SC2086
  (cd "$tmp" && $ruff check $files && $ruff format --check $files)
  status=$?
  rm -rf "$tmp"
  [ "$status" -eq 0 ] || { echo "pre-push: lint or format failed on the pushed files above; run uv run ruff format <file> and uv run ruff check --fix <file>, commit, push again"; exit 1; }
done
