node_modules
.next
# Every console build folder: a use-case run's (OPS_CONSOLE_DIST_DIR) output scanned by Tailwind broke the stack console's CSS.
.next-*
next-env.d.ts
*.tsbuildinfo
.env*
!.env.example
!.devcontainer/.env.local.example

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# make up: service logs and pids
.logs/
.run/
.data/


# Generated DBA scripts (make db-ddl, db-upgrade-sql, db-release); a release attaches them.
/dist/
sdk/python/dist/
sdk/typescript/dist/
sdk/python/uv.lock

# install.sh: the settings file with the install keys, the DBA scripts and backups
/ops-ai.env
/dba/
/backups/

# make deps-doctor output (constraints and npm overrides for one developer's mirror)
.mirror/

# The install's plugins folder: plugins an operator drops in, never committed (docs/guide/plugins.md)
/plugins/*
!/plugins/README.md

# Example setup writes resolved ids for the local team only
examples/**/.bindings.json
examples/**/.ops-profile.json

# Local caches, never source
.pnpm-store/
.playwright-mcp/

# make version: the installed commit or release, kept by scripts/update_from_diff.sh
/VERSION

# Agent settings for one machine (see .claude/workspace.example.md)
.claude/workspace.local.md
