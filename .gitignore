node_modules
.next
# Every console build folder: a second dev server's (OPS_CONSOLE_DIST_DIR) output scanned by Tailwind broke the shared console's CSS.
.next-*
next-env.d.ts
*.tsbuildinfo
.env*
!.env.example
!.devcontainer/.env.local.example

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# make up: service logs and pids
.logs/
.run/
.data/

# The private half of Ops AI (board, plans, private agent setup) is its own repository, cloned here as .private/.
# scripts/link-private.sh links .codeloop and the private agent files into the checkout and lists them in
# .git/info/exclude, so their names never appear in this public file.
/.private/
/.codeloop
# A lane worktree's own settings (name, number, card, ports), written by scripts/lane.sh.
/.lane

# Generated DBA scripts (make db-ddl, db-upgrade-sql, db-release); a release attaches them.
/dist/
sdk/python/dist/
sdk/typescript/dist/
sdk/python/uv.lock

# install.sh: the settings file with the install keys, the DBA scripts and backups
/ops-ai.env
/dba/
/backups/

# make deps-doctor output (constraints and npm overrides for one developer's mirror)
.mirror/

# The install's plugins folder: plugins an operator drops in, never committed (docs/guide/plugins.md)
/plugins/*
!/plugins/README.md

# Example setup writes resolved ids for the local team only
examples/**/.bindings.json
examples/**/.ops-profile.json

# Local caches, never source
.pnpm-store/
.playwright-mcp/
