# Copy to a file outside the repository (or under .run/, which git ignores) and fill in. Never commit the copy.
# A workspace admin: creates the team, its Security-team secret and its people's invitations.
OPS_DEMO_ADMIN_EMAIL=
OPS_DEMO_ADMIN_PASSWORD=
# The password every demo person sets when accepting their invitation; the capture script signs in with it.
OPS_DEMO_PASSWORD=
# The model alias the demo agents run on. Staging's `default` is the fake model on the committed rules; on the local
# shared stack run scripts/demo/local_model.py first and use its alias (bank-assist).
OPS_DEMO_MODEL_ALIAS=default
# Optional: the alias the agents are left on once the seed's scripted chats and runs are made, so a person's own
# chat gets a real model (staging: OPS_DEMO_MODEL_ALIAS=fake, OPS_DEMO_LIVE_MODEL_ALIAS=default).
# OPS_DEMO_LIVE_MODEL_ALIAS=
# The levy story by email. Leave these out to skip it.
# OPS_DEMO_MAILBOX=legal-orders@harborpine.example
# OPS_DEMO_IMAP=mail.harborpine.test:143
# OPS_DEMO_REPLY_SMTP=smtp.harborpine.test:587
# OPS_DEMO_MAIL_TLS=0
# OPS_DEMO_SMTP=127.0.0.1:3025
