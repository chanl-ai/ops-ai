# The answers QA runs make setup with (make setup ANSWERS=scripts/setup/answers.qa.env): our database container, no
# mirrors and the fake model, so it needs no key and makes no model call. Keys are install.sh's plus setup's own.
RUNS_ON=laptop
DOCKER=yes
DATABASE=builtin
PYPI_MIRROR=none
NPM_MIRROR=none
IMAGE_REGISTRY=none
MODEL_PROVIDER=fake
