   }
  },
  {
   "from": {
    "node": "calc",
    "port": "refused"
   },
   "to": {
    "node": "lookup_failed",
    "port": "in"
   }
  },
  {
   "from": {
    "node": "calc",
    "port": "error"
   },
   "to": {
    "node": "lookup_failed",
    "port": "in"
   }
  },
  {
   "from": {
    "node": "checked",
    "port": "ok"
   },
   "to": {
    "node": "review",
    "port": "in"
   }
  },
  {
   "from": {
    "node": "checked",
    "port": "error"
   },
   "to": {
    "node": "review",
    "port": "in"
   }
  },
  {
   "from": {
    "node": "review",
    "port": "hold"
   },
   "to": {
    "node": "hold",
