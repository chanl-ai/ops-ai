# One public origin: the console at /, each browser-facing service at /api/<service>/. The services bind 127.0.0.1 on
# Fly, so this is the only way in; platform-service's internal port (8711) and OPA are not routed, and of models-service
# only the account's provider key routes are (Settings > Model providers): its completions stay internal.
# Each upstream defaults to its port on this machine; OPS_UPSTREAM_<SERVICE> names another (compose's service names,
# deploy/compose/app.yaml).
{
	admin off
	auto_https off
	servers {
		# Fly's proxy terminates TLS and sets X-Forwarded-Proto; trusting it lets the services build https URLs.
		trusted_proxies static private_ranges
	}
}

# A request that reaches a service still starting (agents binds its port after its startup, and caddy has no ready
# gate on it) or restarting is held and its connection retried until the service answers, instead of answering 502
# (c-451). A connection that failed is retried for any request; one the service received is retried only for a GET.
(wait_for_upstream) {
	lb_try_duration 30s
	lb_try_interval 250ms
}

:{$OPS_PUBLIC_PORT:8080} {
	handle_path /api/platform/* {
		reverse_proxy {$OPS_UPSTREAM_PLATFORM:127.0.0.1:8710} {
			import wait_for_upstream
		}
	}
	handle_path /api/agents/* {
		reverse_proxy {$OPS_UPSTREAM_AGENTS:127.0.0.1:8700} {
			import wait_for_upstream
			flush_interval -1
		}
	}
	handle_path /api/tools/* {
		reverse_proxy {$OPS_UPSTREAM_TOOLS:127.0.0.1:8720} {
			import wait_for_upstream
		}
	}
	handle_path /api/kb/* {
		reverse_proxy {$OPS_UPSTREAM_KB:127.0.0.1:8740} {
			import wait_for_upstream
		}
	}
	handle_path /api/files/* {
		reverse_proxy {$OPS_UPSTREAM_FILES:127.0.0.1:8750} {
			import wait_for_upstream
		}
	}
	handle_path /api/documents/* {
		reverse_proxy {$OPS_UPSTREAM_DOCUMENTS:127.0.0.1:8760} {
			import wait_for_upstream
		}
	}
	handle /api/models/v1/provider-keys* {
		uri strip_prefix /api/models
		reverse_proxy {$OPS_UPSTREAM_MODELS:127.0.0.1:8730} {
			import wait_for_upstream
		}
	}
	handle {
		reverse_proxy {$OPS_UPSTREAM_CONSOLE:127.0.0.1:3016} {
			import wait_for_upstream
		}
	}
}
