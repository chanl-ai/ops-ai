# Copy to ~/.config/ops-ai/staging-roles.env (or $OPS_STAGING_CONFIG/staging-roles.env), mode 600. KEY=value lines, no
# quotes. One account per member role in one team of your deployed install; `make seed-roles ENV=staging` makes the
# missing ones and writes their lines, `make roles-check ENV=staging` signs in as each. Never commit the filled-in file.
# The team every role account belongs to (a demo or test team, not Security).
STG_ROLES_TEAM=<team id>
STG_ROLE_ADMIN_EMAIL=<email>
STG_ROLE_ADMIN_PASSWORD=<password>
STG_ROLE_BUILDER_EMAIL=<email>
STG_ROLE_BUILDER_PASSWORD=<password>
STG_ROLE_APPROVER_EMAIL=<email>
STG_ROLE_APPROVER_PASSWORD=<password>
STG_ROLE_VIEWER_EMAIL=<email>
STG_ROLE_VIEWER_PASSWORD=<password>
STG_ROLE_CHAT_USER_EMAIL=<email>
STG_ROLE_CHAT_USER_PASSWORD=<password>
