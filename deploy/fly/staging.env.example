# Copy to ~/.config/ops-ai/staging.env (or $OPS_STAGING_CONFIG/staging.env) and fill in your own Fly app names.
# KEY=value lines, no quotes. The file holds names only, no secrets.
# The one-machine staging app (deploy/fly/fly.toml) and its Postgres app.
STG_APP=<your-app>
STG_DB_APP=<your-db-app>
# Every app staging tooling touches must start with this; stg-deploy refuses anything else. Also the per-service
# apps' prefix (deploy/fly/staging/apps.py). Default: <your-app>.
STG_APP_PREFIX=<app-prefix>
