# Settings for app.yaml (and dba.yaml, try.yaml). Copy it to a folder only the operators can read (never commit the
# copy), fill it in, and pass it with --env-file. Every secret may instead be a file under /run/secrets named after the
# setting in lower case (Docker or Kubernetes secrets; docs/deploy/compose.md, "Secrets as files").

# --- Where people reach it ---------------------------------------------------------------------------------------------
# The origin people open in a browser, scheme and host (and port when not 80/443), no trailing slash. The console and
# the services build every link on it.
OPS_PUBLIC_ORIGIN=http://localhost:8890
# The host port the proxy publishes; put your TLS terminator or load balancer in front of it.
OPS_PUBLIC_PORT=8890

# --- Images ------------------------------------------------------------------------------------------------------------
# Images are <prefix>/<service>:<tag>. A release package sets both to the names in its images.txt; change the prefix
# when you push the images to your own registry. A checkout builds them with -f build.yaml.
OPS_IMAGE_PREFIX=ops-ai
OPS_IMAGE_TAG=dev
# Behind a company registry mirror, a prefix for the third-party images (PostgreSQL, OPA, mail test servers), ending in
# a slash. docs/deploy/install.md, "Behind a company mirror" lists every download setting.
# OPS_BASE_IMAGE_PREFIX=registry.example.com/dockerhub/

# --- Database ----------------------------------------------------------------------------------------------------------
# PostgreSQL 15 or newer, each DSN in SQLAlchemy's asyncpg form: postgresql+asyncpg://<login>:<password>@<host>:5432/<db>
# (add ?ssl=require for a server that requires TLS, such as Azure Database for PostgreSQL).
#
# With a DBA (dba.yaml): the DBA applies the release's database scripts and gives each service its own runtime login
# below (ops_<service>_runtime); leave OPS_DATABASE_URL empty. No login here can change the schema.
# Without a DBA (no dba.yaml): set OPS_DATABASE_URL to a superuser login (the agents chain creates a role with
# BYPASSRLS); the migrate job applies every migration with it, and every service whose own line is empty uses it too.
OPS_DATABASE_URL=
# One per service: the service's own runtime login. Each service keeps its own migration table.
OPS_DATABASE_URL_PLATFORM=
OPS_DATABASE_URL_AGENTS=
OPS_DATABASE_URL_TOOLS=
OPS_DATABASE_URL_MODELS=
OPS_DATABASE_URL_KB=
OPS_DATABASE_URL_FILES=
OPS_DATABASE_URL_DOCUMENTS=
# Only with try.yaml's postgres profile: the password of its built-in PostgreSQL.
OPS_TRY_POSTGRES_PASSWORD=

# --- Keys: replace these lines with the output of
#   docker run --rm --entrypoint python <prefix>/platform:<tag> /app/deploy/fly/generate_keys.py
# Each service's Ed25519 signing key, handed only to that service.
OPS_SVC_KEY_PLATFORM=
OPS_SVC_KEY_AGENTS=
OPS_SVC_KEY_TOOLS=
OPS_SVC_KEY_KB=
OPS_SVC_KEY_FILES=
OPS_SVC_KEY_MODELS=
OPS_SVC_KEY_DOCUMENTS=
OPS_SVC_KEY_RUNNER=
# Every service's public key, as JSON; every callee verifies callers with it.
OPS_SERVICE_PUBLIC_KEYS=
# Signs people's sign-in tokens (platform-service only).
OPS_PLATFORM_SIGNING_KEY=
# Signs approval tokens for tool calls.
OPS_REVIEW_KEY=
# 64 hex characters: seals stored tool and storage credentials. Losing it loses those credentials.
OPS_SECRETS_KEY=

# --- First admin: made by the migrate job on the first run; the password is needed only until then ---------------------
# Tenant id: keep `local` (tools-service still keeps its records under it).
OPS_BOOTSTRAP_TENANT_ID=local
OPS_BOOTSTRAP_TENANT_NAME=Organisation name
OPS_BOOTSTRAP_TEAM_NAME=Security
OPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPS_BOOTSTRAP_ADMIN_NAME=First Admin
# At least 12 characters. Remove it after the admin has signed in and changed it.
OPS_BOOTSTRAP_ADMIN_PASSWORD=

# --- Model keys: printed once by connect_model.py (docs/deploy/compose.md, "Connect a model") --------------------------
# agents-service's key to models-service; until set, agents-service's health is 503 and chats fail.
OPS_MODELS_KEY_AGENTS=
# documents-service's key, for reading documents.
OPS_MODELS_KEY_DOCUMENTS=

# --- Files -------------------------------------------------------------------------------------------------------------
# Upload scanning: `eicar` marks clean files clean with the built-in test engine; `hook` leaves uploads pending until a
# scanner reports. `off` is refused outside development.
OPS_FILES_SCANNING=eicar

# --- Outgoing mail (password resets, notifications); `none` makes sends fail with "not configured" ---------------------
# none, smtp, resend or graph.
OPS_MAIL_PROVIDER=none
OPS_MAIL_FROM=
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
OPS_SMTP_USERNAME=
OPS_SMTP_PASSWORD=
