{
  "schemaVersion": 2,
  "id": "normalize_support_request",
  "name": "Normalize a support request",
  "description": "Map an app's support fields onto the team's canonical shape.",
  "nodes": [
    {
      "id": "start",
      "type": "ops.trigger.request",
      "typeVersion": 1,
      "name": "Support request",
      "parameters": {
        "inputSchema": {
          "type": "object",
          "required": [
            "customerEmail",
            "subject",
            "message"
          ],
          "properties": {
            "customerEmail": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "map",
      "type": "ops.data.set",
      "typeVersion": 1,
      "name": "Canonical fields",
      "parameters": {
        "values": {
          "customer.email": "$.input.customerEmail",
          "title": "$.input.subject",
          "body": "$.input.message",
          "source": "api"
        }
      }
    },
    {
      "id": "done",
      "type": "ops.flow.end",
      "typeVersion": 1,
      "name": "Accepted",
      "parameters": {
        "outcome": "accepted"
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "payload"
      },
      "to": {
        "node": "map",
        "port": "in"
      }
    },
    {
      "from": {
        "node": "map",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    }
  ]
}
