# The schema as scripts a DBA reviews and applies (docs/deploy/database.md), generated by deploy/database/schema.py
# from the migration chains. SERVER is a throwaway server where scratch databases (and the chains' roles) are made;
# nothing here defaults to the dev stack's database. DIALECT=postgresql (default) or mssql: SQL Server's scripts are
# compiled from the store models (deploy/database/mssql.py) and need no SERVER; its drift needs a server (c-345).
.PHONY: db-ddl db-upgrade-sql db-drift db-release db-scripts-proof db-ddl-golden

DIALECT ?= postgresql
REF ?= HEAD
DB_SCHEMA := uv run --quiet --project $(ROOT) python $(ROOT)/deploy/database/schema.py --dialect $(DIALECT)

##@ Database scripts

db-ddl: ## Baseline DDL at REF: roles, one file per service, the bundle, grants, manifest, checksums (SERVER=<url> OUT=<dir>)
	@test -n "$(SERVER)" -o "$(DIALECT)" = mssql || { echo "db-ddl: set SERVER to a throwaway server's admin URL"; exit 2; }
	$(DB_SCHEMA) ddl $(if $(SERVER),--server "$(SERVER)") --out "$(or $(OUT),dist/db/$(REF)/baseline)" --ref "$(REF)"

db-upgrade-sql: ## Guarded upgrade and downgrade SQL between two refs (FROM=<ref> TO=<ref> OUT=<dir>)
	@test -n "$(FROM)" || { echo "db-upgrade-sql: set FROM (and TO, default HEAD)"; exit 2; }
	$(DB_SCHEMA) upgrade-sql --from "$(FROM)" --to "$(or $(TO),HEAD)" --out "$(or $(OUT),dist/db/$(or $(TO),HEAD)/upgrade-from-$(FROM))"

db-drift: ## Every difference between a live database and the schema its version rows describe (DATABASE=<url> SERVER=<url>)
	@test "$(DIALECT)" = mssql -o \( -n "$(DATABASE)" -a -n "$(SERVER)" \) || { echo "db-drift: set DATABASE and SERVER"; exit 2; }
	$(DB_SCHEMA) drift $(if $(DATABASE),--database "$(DATABASE)") $(if $(SERVER),--server "$(SERVER)") --ref "$(REF)"

db-release: ## A release's scripts: TAG's baseline and the upgrade from FROM, in dist/db/TAG (SERVER=<url> TAG=<ref> FROM=<ref>)
	@test -n "$(TAG)" -a -n "$(FROM)" -a \( -n "$(SERVER)" -o "$(DIALECT)" = mssql \) || { echo "db-release: set SERVER, TAG and FROM"; exit 2; }
	$(DB_SCHEMA) ddl $(if $(SERVER),--server "$(SERVER)") --out dist/db/$(TAG)/baseline --ref "$(TAG)"
	$(DB_SCHEMA) upgrade-sql --from "$(FROM)" --to "$(TAG)" --out dist/db/$(TAG)/upgrade-from-$(FROM)

db-ddl-golden: ## SQL Server DDL from this checkout's models into deploy/database/golden/mssql, after review (c-344)
	uv run --quiet --project $(ROOT) python $(ROOT)/deploy/database/schema.py --dialect mssql golden

db-scripts-proof: ## The DBA scripts' proof on a throwaway PostgreSQL of its own (FROM=<older ref>)
	sh $(ROOT)/deploy/database/proof.sh $(FROM)
