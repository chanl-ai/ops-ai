{
  "name": "ops-ai",
  "private": true,
  "packageManager": "pnpm@10",
  "scripts": {
    "dev": "pnpm --filter @ops-ai/console dev",
    "build": "pnpm --filter @ops-ai/console build",
    "typecheck": "pnpm --filter @ops-ai/console typecheck",
    "verify": "pnpm --filter @ops-ai/console verify",
    "prepare": "cp .githooks/pre-commit .git/hooks/pre-commit 2>/dev/null && chmod +x .git/hooks/pre-commit || true"
  },
