{
  "name": "ops-ai",
  "private": true,
  "packageManager": "pnpm@10",
  "scripts": {
    "dev": "pnpm --filter @ops-ai/console dev",
    "dev:runtime": "pnpm --filter @ops-ai/console dev:runtime",
    "build": "pnpm --filter @ops-ai/console build",
    "typecheck": "pnpm --filter @ops-ai/console typecheck",
    "verify": "pnpm --filter @ops-ai/console verify && node scripts/check-docs.mjs && node scripts/check-public-paths.mjs --self-test && node scripts/check-public-paths.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "prepare": "sh scripts/install-hooks.sh 2>/dev/null || true"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@ops-ai/usecase-runner": "workspace:*",
    "marked": "18.1.1",
    "mermaid": "12.2.0"
  }
}
