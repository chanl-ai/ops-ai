# Local secrets and overrides for `make up`. Copy to .env (gitignored) and fill in; make loads .env when it exists and
# exports every KEY=value line to the services, the console and the use-case runner. Plain KEY=value, no quotes, no
# `export`. A value already in your shell wins over this file. Anything not set here keeps the settings default
# (packages/ops_service_kit/src/ops_service_kit/settings.py) or the port defaults in make/env.mk.

# Model provider for chat and agent turns (one is enough; the default alias `default` runs through models-service; a direct call needs OPS_MODEL_ALIAS set to a provider model and its key)
OPENAI_API_KEY=
# Which model `make up` points every model name at. OpenAI is the default (needs OPENAI_API_KEY and a route to
# api.openai.com). Set DEMO_MODEL=fake to run on the local fake model: no key, no cost, no outside calls.
# DEMO_MODEL=fake
ANTHROPIC_API_KEY=

# Ports: uncomment to move one; everything that depends on it follows
# OPS_AGENTS_PORT=8700
# OPS_TOOLS_PORT=8720
# OPS_CONSOLE_PORT=3016
# OPS_OPA_PORT=8181
# OPS_PG_PORT=5477

# Runtime switches (dev defaults shown)
# OPS_MODEL_ALIAS=default
# OPS_REGISTRY_AUTO_APPROVE=true
# OPS_ALLOW_SELF_APPROVAL_IN_CHAT=true

# Email (packages/ops_email, docs/packages/ops_email/overview.md). The dev stack reads and writes folders under .run/.
# OPS_MAILBOX_SOURCE=none            # none | graph
# OPS_GRAPH_TENANT_ID=
# OPS_GRAPH_CLIENT_ID=
# OPS_GRAPH_CLIENT_SECRET=
# OPS_EMAIL_POLL_SECONDS=30
# OPS_MAIL_PROVIDER=none             # none | fake (dev) | smtp | resend | graph
# OPS_MAIL_FROM=
# OPS_SMTP_HOST=
# OPS_SMTP_PORT=587
# OPS_SMTP_USERNAME=
# OPS_SMTP_PASSWORD=
# OPS_RESEND_API_KEY=
